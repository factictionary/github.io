{
  "id": "/",
  "name": "Factictionary — 85+ Privacy Web Tools & File Readers",
  "short_name": "Factictionary",
  "description": "85+ 100% client-side privacy-first browser utilities (EPUB, DOCX, Excel, CBZ, PDF, Teleprompter, Tambola), 14 offline-ready Android apps, and 13 handbooks.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "tabbed",
    "window-controls-overlay",
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "tab_strip": {
    "home_tab": {
      "url": "/?source=pwa",
      "icons": [
        {
          "src": "/assets/images/factictionary-logo-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    "new_tab_button": {
      "url": "/tools/"
    }
  },
  "orientation": "any",
  "background_color": "#0F172A",
  "theme_color": "#0066FF",
  "lang": "en",
  "dir": "ltr",
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "categories": [
    "utilities",
    "productivity",
    "education",
    "games",
    "developer tools"
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=in.factictionary.virtual_tambola",
      "id": "in.factictionary.virtual_tambola"
    },
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=in.factictionary.speak_smart",
      "id": "in.factictionary.speak_smart"
    },
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=in.factictionary.chalkly",
      "id": "in.factictionary.chalkly"
    },
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=in.factictionary.duocards",
      "id": "in.factictionary.duocards"
    }
  ],
  "scope_extensions": [
    {
      "origin": "https://factictionary.in"
    },
    {
      "origin": "https://www.factictionary.in"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "note_taking": {
    "new_note_url": "/tools/online_teleprompter.html?new=1"
  },
  "icons": [
    {
      "src": "/assets/images/factictionary-logo-96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/images/factictionary-logo-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/images/factictionary-logo-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/assets/images/factictionary-logo-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/images/factictionary-logo-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/assets/images/factictionary-tools-infographic-1280x800.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Factictionary Ecosystem — All 85+ Free Private Browser Tools & 8 Studios at a Glance"
    },
    {
      "src": "/assets/images/factictionary-banner-wide.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Factictionary 85+ Privacy-First Browser Utilities & File Readers"
    },
    {
      "src": "/assets/images/factictionary-banner-narrow.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Factictionary Mobile Web Tools & Offline Android App Hub"
    }
  ],
  "shortcuts": [
    {
      "name": "In-Browser EPUB Reader",
      "short_name": "EPUB Reader",
      "description": "Open and read .epub eBooks locally in your browser with TTS",
      "url": "/tools/epub_reader.html?source=pwa_shortcut",
      "icons": [
        {
          "src": "/assets/images/factictionary-logo-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Studio Teleprompter",
      "short_name": "Teleprompter",
      "description": "Browser teleprompter with eye-line focus band and WPM calculator",
      "url": "/tools/online_teleprompter.html?source=pwa_shortcut",
      "icons": [
        {
          "src": "/assets/images/factictionary-logo-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Tambola 1-90 Caller",
      "short_name": "Tambola Caller",
      "description": "Host Tambola / Housie with voice nicknames and WhatsApp tickets",
      "url": "/tools/tambola_caller.html?source=pwa_shortcut",
      "icons": [
        {
          "src": "/assets/images/factictionary-logo-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Client-Side PDF Merger",
      "short_name": "PDF Merger",
      "description": "Merge, split, and compress PDF files 100% locally",
      "url": "/tools/pdf_merger.html?source=pwa_shortcut",
      "icons": [
        {
          "src": "/assets/images/factictionary-logo-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "/tools/epub_reader.html",
      "accept": {
        "application/epub+zip": [
          ".epub"
        ]
      }
    },
    {
      "action": "/tools/docx_viewer.html",
      "accept": {
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
          ".docx"
        ]
      }
    },
    {
      "action": "/tools/excel_csv_viewer.html",
      "accept": {
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [
          ".xlsx"
        ],
        "text/csv": [
          ".csv"
        ]
      }
    },
    {
      "action": "/tools/cbz_comic_reader.html",
      "accept": {
        "application/vnd.comicbook+zip": [
          ".cbz"
        ]
      }
    },
    {
      "action": "/tools/pdf_merger.html",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+factictionary",
      "url": "/tools/?q=%s"
    }
  ],
  "share_target": {
    "action": "/tools/word_counter.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "widgets": [
    {
      "name": "Factictionary Quick Tools",
      "description": "Instant access to 85+ client-side file readers and privacy utilities.",
      "tag": "factictionary-tools",
      "template": "factictionary-tools-template",
      "ms_ac_template": "/assets/widgets/tools-widget.json",
      "data": "/assets/widgets/tools-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/assets/images/factictionary-banner-wide.png",
          "sizes": "1280x800",
          "label": "Factictionary Quick Tools Widget"
        }
      ],
      "icons": [
        {
          "src": "/assets/images/factictionary-logo-96.png",
          "sizes": "96x96"
        }
      ],
      "auth": false,
      "update": 86400
    }
  ]
}
